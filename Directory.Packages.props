<Project>

  <!--
    Central Package Management for the InkWell solution.

    ⚠️ CRITICAL RULE (research.md §2): exactly ONE SQLitePCLRaw bundle may ever be referenced by
    this solution. Referencing a second bundle (for example `sqlite-net-pcl`, or any non-`.Core`
    EF Core SQLite package) double-links the native SQLite library and crashes on iOS with an
    `e_sqlite3` load failure. `sqlite-net-sqlcipher` + `SQLitePCLRaw.bundle_e_sqlcipher` is the
    single approved pairing. Do not add another.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Presentation (MAUI)">
    <!--
      Must be >= 10.0.60 because CommunityToolkit.Maui 15.0.0 requires it. This floats above the
      installed `maui-windows` workload manifest (10.0.20), which is supported: the workload
      supplies the build targets while the package supplies the runtime assemblies.
    -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.0" />
  </ItemGroup>

  <ItemGroup Label="Persistence — the single approved SQLitePCLRaw bundle">
    <PackageVersion Include="sqlite-net-sqlcipher" Version="1.9.172" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup Label="Markdown and export">
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
