<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) OR $(MSBuildProjectName.EndsWith('.UiTests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Constitution §VI: public APIs carry XML documentation, which is emitted as auto-generated API
    docs. CS1591 (missing XML comment) stays a warning rather than an error so that scaffolding a
    type and documenting it are separate steps, but it must be driven to zero (task T126).
  -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' AND '$(MSBuildProjectName)' != 'InkWell.Maui'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Warnings are errors in the layers InkWell owns end to end. The two MAUI projects are excluded:
    their compilation includes generated XAML and platform partials whose analyzer output this
    codebase does not control, and failing a build on those would train people to ignore warnings.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' AND '$(MSBuildProjectName)' != 'InkWell.Maui' AND '$(MSBuildProjectName)' != 'InkWell.Presentation'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Apple targets (`net10.0-ios`, `net10.0-maccatalyst`) require a macOS build host or a paired Mac.
    They are always built in CI on macOS and can be opted into locally with
    `-p:EnableAppleTargets=true`; on a Windows/Linux dev box they are excluded so that
    `dotnet build` on the solution succeeds without a Mac.
  -->
  <PropertyGroup>
    <EnableAppleTargets Condition="'$(EnableAppleTargets)' == '' AND $([MSBuild]::IsOSPlatform('osx'))">true</EnableAppleTargets>
    <EnableAppleTargets Condition="'$(EnableAppleTargets)' == ''">false</EnableAppleTargets>
  </PropertyGroup>

</Project>
