<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Central Package Management requires either a single package source or explicit source mapping.
    InkWell restores exclusively from nuget.org so that builds are reproducible on any machine and
    are not affected by feeds configured in a developer's global NuGet.config.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
