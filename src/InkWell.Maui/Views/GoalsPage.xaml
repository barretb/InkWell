<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:InkWell.Application.Abstractions.Dtos;assembly=InkWell.Application"
             xmlns:vm="clr-namespace:InkWell.Presentation.ViewModels;assembly=InkWell.Presentation"
             x:Class="InkWell.Maui.Views.GoalsPage"
             x:DataType="vm:GoalsViewModel"
             Title="Daily goal">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Style="{StaticResource HeadingLabel}"
                   Text="Daily writing goal"
                   SemanticProperties.HeadingLevel="Level1" />

            <!-- Set or change the target -->
            <!-- No save button: the target persists as it is typed (FR-004). -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0"
                       Text="{Binding TargetInput}"
                       Keyboard="Numeric"
                       Placeholder="Words per day, for example 500"
                       SemanticProperties.Description="Daily word-count target" />

                <Button Grid.Column="1"
                        Text="Clear"
                        Style="{StaticResource DangerButton}"
                        IsVisible="{Binding HasActiveGoal}"
                        Command="{Binding ClearGoalCommand}"
                        SemanticProperties.Hint="Stops tracking progress. Your writing history is kept." />
            </Grid>

            <!--
                Progress. The bar is decoration: everything it shows is also stated in
                ProgressSummary, which is what a screen reader announces and what remains legible
                in greyscale (FR-019, SC-007).
            -->
            <Border Padding="16" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource HeadingLabel}"
                           FontSize="17"
                           Text="Today"
                           SemanticProperties.HeadingLevel="Level2" />

                    <ProgressBar Progress="{Binding ProgressFraction}"
                                 IsVisible="{Binding HasActiveGoal}"
                                 HeightRequest="10" />

                    <Label Text="{Binding ProgressSummary}"
                           SemanticProperties.Description="{Binding ProgressSummary}" />

                    <Label Style="{StaticResource StatusLabel}"
                           Text="{Binding StatusText}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource HeadingLabel}"
                   FontSize="17"
                   Text="Recent days"
                   SemanticProperties.HeadingLevel="Level2" />

            <Label Style="{StaticResource EmptyStateLabel}"
                   IsVisible="{Binding HasNoHistory}"
                   Text="Nothing written yet. Once you start drafting, each day's total appears here." />

            <CollectionView ItemsSource="{Binding History}" SelectionMode="None" HeightRequest="320">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:WritingHistoryEntry">
                        <Border Padding="12" Margin="0,0,0,8" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="2">
                                <Label FontFamily="OpenSansSemibold"
                                       Text="{Binding Date, StringFormat='{0:ddd d MMM yyyy}'}" />
                                <!-- "Goal met" / "Goal not met" in words, never a coloured dot. -->
                                <Label Style="{StaticResource SecondaryLabel}"
                                       Text="{Binding Outcome}"
                                       SemanticProperties.Description="{Binding Outcome}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Style="{StaticResource StatusLabel}"
                   Text="{Binding StatusMessage}"
                   SemanticProperties.Description="{Binding StatusMessage}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
